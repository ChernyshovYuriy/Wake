# hl-whale-signals on a Raspberry Pi: install, enable, check, logs.
# Units: system/hlsignals-*.service|.timer (templates; install-services.sh fills in
# the user and app directory).

# --- one-time setup (as the service user, e.g. pi) ---------------------------------
git clone <repo> ~/dev/hl-whale-signals && cd ~/dev/hl-whale-signals
bash system/setup-pi.sh                      # Python >= 3.12 check, .venv, install
sudo bash system/install-services.sh          # copies units, daemon-reload

# --- enable (first deployment only) ---------------------------------------------
sudo systemctl enable --now hlsignals-census.service     # always on: builds the wallet funnel
sudo systemctl enable --now hlsignals-discover.timer     # Sat 02:00 ET: census -> shortlist
sudo systemctl enable --now hlsignals-run.timer          # Mon-Fri 08:45 ET: daily report
sudo systemctl enable --now hlsignals-backtest.timer     # Sun 02:00 ET: does it work?

systemctl list-timers --all | grep hlsignals

# --- run a job now (e.g. first discovery after the census has run a few days) ----
sudo systemctl start hlsignals-discover.service
sudo systemctl start hlsignals-run.service
sudo systemctl start hlsignals-backtest.service

# --- logs -------------------------------------------------------------------------
journalctl -u hlsignals-census.service -n 50 --no-pager
journalctl -u hlsignals-discover.service -n 100 --no-pager
journalctl -u hlsignals-run.service -n 100 --no-pager
journalctl -u hlsignals-backtest.service -n 100 --no-pager
journalctl -u hlsignals-census.service -f          # follow live

# --- outputs ----------------------------------------------------------------------
ls -lt data/reports/ | head                  # signals-YYYY-MM-DD.{txt,md,json}, backtest-*
cat data/reports/latest.md                   # today's report
cat data/discovered_wallets.toml             # the current shortlist
sqlite3 data/census.sqlite 'select count(*), sum(n_fills >= 20) from wallets'

# --- after `git pull` --------------------------------------------------------------
.venv/bin/pip install -e .                   # if dependencies changed
sudo bash system/install-services.sh         # if unit files changed
sudo systemctl restart hlsignals-census.service
# A changed OnCalendar needs the timer restarted too:
sudo systemctl restart hlsignals-run.timer hlsignals-discover.timer hlsignals-backtest.timer

# --- timeline for a new deployment with no wallets ----------------------------------
# day 0      enable everything; the census starts collecting
# first Sat  discover vets the census (more wallets qualify the longer the census ran)
# daily      reports follow config/wallets.toml + data/discovered_wallets.toml;
#            until the shortlist has trusted wallets, every stock is "insufficient"
# weekly     the backtest verdict says whether the shortlist's signals beat buy-and-hold
